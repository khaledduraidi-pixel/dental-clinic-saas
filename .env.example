# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WhatsApp integration
# true = mock mode (messages logged in-app, nothing sent to Meta). Default for local dev.
VITE_WHATSAPP_MOCK=true

# Only needed by the Edge Functions (supabase/functions), not by the Vite app.
# Set these as Supabase secrets: `supabase secrets set KEY=value`
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_APP_SECRET=
# The string you enter as "Verify token" when registering the webhook URL
# in the Meta App Dashboard — any random string you choose, must match here.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
